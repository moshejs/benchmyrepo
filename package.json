{
  "name": "benchmyrepo",
  "version": "0.1.0",
  "description": "Benchmark the coding agents you already have on your own repo's merged PRs. Local, one command.",
  "type": "module",
  "bin": { "benchmyrepo": "bin/benchmyrepo.js" },
